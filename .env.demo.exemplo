# Copie para .env.demo e preencha. O .env.demo NÃO vai para o git.
#
#   cp .env.demo.exemplo .env.demo

# Assina os tokens de login. Sem isso a API não sobe, de propósito.
# Gere um novo com:  openssl rand -base64 48
JWT_SECRET=

# O primeiro gestor, criado só quando o banco está vazio.
# Use uma senha de verdade: este endereço vai ficar acessível na internet.
GESTOR_INICIAL_EMAIL=voce@exemplo.com
GESTOR_INICIAL_SENHA=
GESTOR_INICIAL_NOME=Diego
