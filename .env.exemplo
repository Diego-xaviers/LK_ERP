# Copie para .env e preencha. O .env NÃO vai para o git.
#
#   cp .env.exemplo .env

# --- Endereço ------------------------------------------------------------
# Domínio que aponta para esta VPS. O Caddy emite o certificado HTTPS para ele.
# Para testar antes de o DNS propagar, use  DOMINIO=:80  (sem HTTPS).
DOMINIO=painel.suaempresa.com.br

# O mesmo domínio, com https:// e SEM barra no fim. É daqui que sai a URL
# que vai dentro do pacote do agente de telemetria.
URL_PUBLICA=https://painel.suaempresa.com.br

# --- Banco ---------------------------------------------------------------
POSTGRES_DB=lktransportes
POSTGRES_USER=lk
# Gere com:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Segurança -----------------------------------------------------------
# Assina os tokens de login. Sem isso a API não sobe, de propósito.
# Gere com:  openssl rand -base64 48
JWT_SECRET=

# --- Bot do VTLog --------------------------------------------------------
# Token do bot em discord.com/developers/applications → Bot → Reset Token.
DISCORD_TOKEN=
# Id do canal #registro-vtlog (Modo Desenvolvedor ligado → botão direito no canal).
VTLOG_CHANNEL_ID=
# Senha que a api e o bot usam entre si. Gere com:  openssl rand -base64 24
VTLOG_SECRET=
# Id da VTC no VTLog — vtlog.net/vtc/<id>
VTC_ID=7777

# --- Primeiro acesso -----------------------------------------------------
# Só usados quando o banco está vazio. Depois de entrar, troque a senha
# no painel e APAGUE a linha da senha daqui.
GESTOR_INICIAL_EMAIL=voce@suaempresa.com.br
GESTOR_INICIAL_SENHA=
GESTOR_INICIAL_NOME=Administrador
